{
    "imap": {
        "user": "USERNAME",
        "password": "PASSWORD",
        "host": "IMAPHOST",
        "port": 993,
        "tls": true
    },
    "filters": [
        {
            "name": "Filter name, just for you to read",
            "search": {
                "seen": false,
                "from": "mail@of.sender",
                "subject": "part of subject",
                "or": [{ "to": "one@example.org" }, { "to": "other@example.org" }]
            },
            "path": "some path to store files to",
            "renameRule": "%YEAR%-%MONTH%-%DAY% some fixed text or %NAME% to insert filename of attachment.pdf",
            "filterFilename": ".pdf (optional, only attachments with this in the name)",
            "mailBoxDone": "INBOX/MOVEPROCESSEDSTUFFHERE (optional)",
            "mailBoxToWatch": "INBOX/WatchAnotherFolder (optional, default INBOX)",
            "disabled": false
        }
    ],
    "logger": {
        "useSeq": true,
        "serverUrl": "seq-server-url",
        "apiKey": "seq-api-key",
        "useConsole": true,
        "debug": false
    }
}
